VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_secret_key

# Local dev only — magic links return here (must match Supabase Redirect URLs)
VITE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# Set to true to auto sign-in as an anonymous guest in dev (writes to the hosted Supabase project)
# VITE_DEV_GUEST=true

# Supabase Personal Access Token (dashboard account) — local scripts only, never commit real value
SUPABASE_TOKEN=
